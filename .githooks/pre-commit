#!/usr/bin/env bash
set -u

git diff --cached --quiet && exit 0

HOOKDIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
echo "security-review: checking staged change" >&2
BEFORE=$(git write-tree) || exit 1

"$HOOKDIR/security-review.sh"
RC=$?

AFTER=$(git write-tree) || exit 1
[ "$BEFORE" = "$AFTER" ] || {
  echo "security-review: staged tree changed during review" >&2
  exit 1
}

exit "$RC"
