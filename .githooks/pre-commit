#!/usr/bin/env bash
# Mechanical checks against the staged change. Judgement belongs to the review
# the agent orchestrates before it gets here (ADR-0013).
set -uo pipefail

git diff --cached --quiet && exit 0

REPO=$(git rev-parse --show-toplevel)
RC=0

say() { printf 'pre-commit: %s\n' "$*" >&2; }

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git "$REPO" --staged --redact || RC=1
else
  say "gitleaks unavailable"
fi

if [ -f "$REPO/Cargo.toml" ]; then
  if ! command -v cargo >/dev/null 2>&1; then
    say "cargo unavailable"
  else
    # cargo reads the working tree, not the index. With unstaged edits present
    # these checks describe something other than the commit.
    git diff --quiet || say "unstaged edits present — cargo checks read the working tree, not the staged change"

    cargo fmt --check || RC=1
    cargo check --all-targets --quiet || RC=1
  fi
fi

exit "$RC"
