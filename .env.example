# Skuffen — miljøvariabler for lokal kjøring.
# Kopier til .env. Prod-verdiene settes i Terraform: infra/arkiv-operations/modules/skuffen.

# --- Påkrevd: tjenesten starter ikke uten disse ---

# Må være en IP-adresse. `localhost` feiler fordi verdien parses som SocketAddr.
APP_APPLICATION__HOST="127.0.0.1"
APP_APPLICATION__PORT="8080"

NATS_URL="nats://127.0.0.1:4222"

# Styrer om lib-sql kobler over TCP (local) eller Cloud SQL unix socket (alt annet).
APP_APPLICATION__ENVIRONMENT="local"

DATABASE_USER=""
DATABASE_PASSWORD=""
DATABASE_NAME="skuffen"
# Kun når APP_APPLICATION__ENVIRONMENT=local:
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="5432"
# Kun når APP_APPLICATION__ENVIRONMENT != local (Cloud SQL instance connection name):
# DATABASE_CONNECTION_NAME=""

# Leses av sikri_client. Uten den panikker første arkivkall, ikke oppstarten.
BASE_URL_SIKRI=""
# GCP-prosjektet Sikri-credentials hentes fra i Secret Manager.
APP_APPLICATION__PROJECT_ID=""

# --- Valgfri ---

# local, dev eller test slår av TLS-krav og tillater fake-adaptere.
# Usatt betyr produksjonsmodus: TLS påkrevd, fake forbudt, https påkrevd.
APP_ENV="local"

# Innholdet i creds-filen, ikke en sti til den. En sti gir panic ved oppstart.
APP_NATS_CREDENTIALS=""

# Default 3. Sett 1 mot en enkeltnode-NATS lokalt.
APP_NATS_JETSTREAM_REPLICAS="1"

# "1" slår på fake Sikri-gateway. Krever APP_ENV in (local, dev, test).
SKUFFEN_FAKE_SIKRI=""

# Uten denne feiler HTML-mal-rendering recoverable, altså retry for alltid.
SKUFFEN_HTML2PDF_RENDERER_ENDPOINT=""

# Usatt gir http://127.0.0.1:4317. I Cloud Run tar OTel-sidecaren imot der.
OTEL_EXPORTER_OTLP_ENDPOINT=""
RUST_LOG="info"

# --- Kun for integration-tests/src/bin/skuffen-manual.rs ---

SIKRI_SAKSBEHANDLER_ID=""
SIKRI_SAKSBEHANDLER_ENHET=""
