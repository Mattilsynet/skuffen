  "components": {
    "schemas": {
      "ElementsAvsenderMottaker": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "navn": {
            "type": "string",
            "nullable": true
          },
          "organisasjonsnummer": {
            "type": "string",
            "nullable": true
          },
          "epost": {
            "type": "string",
            "nullable": true
          },
          "telefon": {
            "type": "string",
            "nullable": true
          },
          "postadresse": {
            "type": "string",
            "nullable": true
          },
          "postnummer": {
            "type": "string",
            "nullable": true
          },
          "poststed": {
            "type": "string",
            "nullable": true
          },
          "utlandsadresse": {
            "type": "string",
            "description": "Address abroad.\r\nErstatter postnr og poststed for adresser i utlandet.",
            "nullable": true
          },
          "forsendelsesmetode": {
            "type": "string",
            "description": "Trigger automatisk elektronisk ekspedering av utgående post/signeringsoppdrag\r\nEks: NULL - elektronisk ekspedering\r\nEks: GENERELL - digital post med svarut\r\nEks: SO - signeringsoppdrag",
            "nullable": true
          },
          "erMottaker": {
            "type": "boolean",
            "nullable": true
          },
          "kopi": {
            "type": "boolean",
            "nullable": true
          },
          "unntattOffentlighet": {
            "type": "boolean"
          },
          "person": {
            "type": "boolean",
            "description": "true hvis avsender/mottaker er en person"
          },
          "tilSaksbehandler": {
            "type": "string",
            "description": "Mottakende saksbehandler\r\nAngi blank verdi for å legge ufordelt til TilSaksbehandlerEnhet",
            "nullable": true
          },
          "tilSaksbehandlerEnhet": {
            "type": "string",
            "description": "Mottakende enhet",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ElementsDokument": {
        "type": "object",
        "properties": {
          "tittel": {
            "type": "string",
            "nullable": true
          },
          "hoveddokument": {
            "type": "boolean"
          },
          "publisert": {
            "type": "boolean",
            "description": "Default er denne satt til false på dokument men den kan settes til true her dersom man vil ha mulighet for fulltekstpublisering",
            "nullable": true
          },
          "filtype": {
            "type": "string",
            "description": "File extensions, eksempel: PDF",
            "nullable": true
          },
          "dokumentBase64": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ElementsDokumentRespons": {
        "type": "object",
        "properties": {
          "tittel": {
            "type": "string",
            "nullable": true
          },
          "hoveddokument": {
            "type": "boolean"
          },
          "publisert": {
            "type": "boolean",
            "description": "Default er denne satt til false på dokument men den kan settes til true her dersom man vil ha mulighet for fulltekstpublisering",
            "nullable": true
          },
          "filtype": {
            "type": "string",
            "description": "File extensions, eksempel: PDF",
            "nullable": true
          },
          "dokumentBase64": {
            "type": "string",
            "nullable": true
          },
          "dokumentId": {
            "type": "integer",
            "format": "int32"
          },
          "hoveddokId": {
            "type": "integer",
            "description": "DokumentBeskrivelseId til hoveddokument i journalposten",
            "format": "int32",
            "nullable": true
          },
          "dokumentUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ElementsJournalpost": {
        "type": "object",
        "properties": {
          "tittel": {
            "type": "string",
            "nullable": true
          },
          "dokumentDato": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "journalposttype": {
            "type": "string",
            "description": "Tilsvarer DokumentType i Elements.\r\nGyldige vedier: I (Inngående dokument), U (Utgående dokument) og X (internt notat uten oppfølging)\r\nHvis verdien er I må man spesifere en avsender på journalposten. \r\nHvis verdien er U må man spesifere en mottaker på journalposten. \r\nHvis verdien er X trenger man hverken avsender eller mottaker.",
            "nullable": true
          },
          "journalstatus": {
            "type": "string",
            "description": "Journalpoststatus benyttes for å angi hvor langt en journalpost er kommet i  forhold til registrering i journalen",
            "nullable": true
          },
          "avskrivDirekte": {
            "type": "boolean",
            "nullable": true
          },
          "avskrivningsmaate": {
            "type": "string",
            "nullable": true
          },
          "tilgangskode": {
            "type": "string",
            "nullable": true
          },
          "tilgangshjemmel": {
            "type": "string",
            "nullable": true
