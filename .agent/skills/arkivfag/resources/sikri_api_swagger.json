    "/api/Archive/OpprettJournalpost": {
      "post": {
        "tags": [
          "Archive"
        ],
        "summary": "Oppretter ny journalpost i en eksisterende sak",
        "parameters": [
          {
            "name": "kildesystem",
            "in": "query",
            "description": "Kildesystem",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "saksnr",
            "in": "query",
            "description": "Saksnummer som journalposten skal legges på. Eks. 2012/123",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "En klasse som inneholder nødvendig informasjonen om den nye journalposten. \r\n            Journalpostens type kan være I (inngående), U (utgående) eller X (internt notat uten oppfølging). \r\n            Hvis verdien er I må man spesifere en avsender på journalposten. \r\n            Hvis verdien er U må man spesifere en mottaker på journalposten. \r\n            Hvis verdien er X trenger man hverken avsender eller mottaker.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ElementsJournalpost"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ElementsJournalpost"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ElementsJournalpost"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElementsJournalpostRespons"
                }
              }
            }
          }
        }
      }
    },
