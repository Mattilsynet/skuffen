            }
          }
        }
      }
    },
    "/api/Archive/HentLoggInformasjon": {
      "get": {
        "tags": [
          "Archive"
        ],
        "summary": "Søk etter endringer i saker og journalposter",
        "parameters": [
          {
            "name": "kildesystem",
            "in": "query",
            "description": "Kildesystem",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "endringerFraTidspunkt",
            "in": "query",
            "description": "f.eks 2025-04-20 22:00:00",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "databaseTabell",
            "in": "query",
            "description": "angi blank for alle tabeller eller angi navn på en spesifikk tabell, som f.eks en av disse: NOARKSAK,JOURNPOST,DOKBESKRIV,DOKVERSJON,AVSMOT",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ElementsLoggInfoRespons"
                  }
                }
              }
            }
          }
        }
      }
    },
