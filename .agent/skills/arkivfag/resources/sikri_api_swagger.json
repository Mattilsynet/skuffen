    "/api/Archive/SetJournalpostFordeltTil": {
      "put": {
        "tags": [
          "Archive"
        ],
        "summary": "Oppretter intern mottaker på journalpost.\r\nHvis angitt mottaker ikke finnes fra før vil den opprettes. \r\nMan kan fordele til flere saksbehandlere (også innenfor samme enhet).\r\nHvis man kun angir enhet vil mottaker opprettes som ufordelt på enheten.\r\nNy mottaker opprettes ikke hvis angitt mottaker er det samme som ansvarlig saksbehander på journalposten.\r\nHvis man angir mottaker/enhet og enheten finnes allerede som ufordelt, vil denne mottaker oppdateres med angitt saksbehandler.",
        "parameters": [
          {
            "name": "kildesystem",
            "in": "query",
            "description": "Kildesystem",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "journalpostId",
            "in": "query",
            "description": "JournalpostId",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "saksbehandler",
            "in": "query",
            "description": "Saksbehandlers brukernavn/ansattnr. Eks: 14049",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "saksbehandlerEnhet",
            "in": "query",
            "description": "Kortnavn på saksbehandlers enhet. Eks: M34500",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
