              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ElementsDokument"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ElementsDokumentRespons"
                  }
                }
              }
            }
          }
        }
      }
    },
